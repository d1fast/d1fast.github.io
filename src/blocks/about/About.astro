---
import './about.css';
import fs from 'node:fs';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Фото: положить файл в public/photo/me.jpg (или .webp, .png), пропорция 4:5. Пока его нет, стоит заглушка.
const photo = ['me.webp', 'me.jpg', 'me.png'].find((f) => fs.existsSync(`public/photo/${f}`));
const ui = {
  ru: { hint: 'их можно двигать, кстати', keys: 'Наклейку в фокусе двигают стрелки.' },
  en: { hint: 'you can move them, by the way', keys: 'Arrow keys move the focused sticker.' },
}[lang];

// заголовок по буквам: первая буква курсивная, её обводит рука (кольцо подгоняет скрипт по самой букве)
const words = d.about.title.split(' ');
// в лиде слово между звёздочками выделено курсивом и подчёркнуто от руки
const [leadA, emph = '', leadB = ''] = d.about.lead.split('*');
const initials = d.hero.name.split(/\s+/).map((w) => w[0]).join('');

// формы наклеек: фигурный круг, овал, круглая наклейка, вырезанная ножницами чуть неровно
const r2 = (n: number) => Math.round(n * 100) / 100;
const radial = (fn: (a: number, i: number) => number, steps: number) => {
  let p = '';
  for (let i = 0; i < steps; i++) {
    const a = (i / steps) * Math.PI * 2 - Math.PI / 2;
    const r = fn(a, i);
    p += (i ? 'L' : 'M') + r2(50 + Math.cos(a) * r) + ',' + r2(50 + Math.sin(a) * r);
  }
  return p + 'Z';
};
const scallop = radial((a) => 44 + 5 * Math.abs(Math.cos(a * 7)), 280);
const round = radial((a) => 48 + 0.9 * Math.sin(a * 3 + 0.6) + 0.6 * Math.cos(a * 5), 120);
const roundIn = radial((a) => 42 + 0.7 * Math.sin(a * 3 + 0.6) + 0.5 * Math.cos(a * 5), 120);
const [stScallop, stOval, stRound] = d.about.stickers;
// слова с дефисом не рвём по дефису
const words2 = (s: string) => s.split(' ').map((w, i) => ({ w, sp: i > 0, nw: w.includes('-') }));

// Фон: карандашные пометки на полях разворота (спираль, звёздочка, кубик, скобки кода, петля, искра, зигзаг)
// и кофейный круг от кружки. Рисуются от руки при входе в блок.
const spiral = (() => {
  let d = '';
  for (let i = 0; i <= 96; i++) {
    const t = i / 96, a = t * Math.PI * 2 * 3.2, r = 3 + t * 42 + Math.sin(i * 1.7) * 0.8;
    d += (i ? 'L' : 'M') + r2(50 + Math.cos(a) * r) + ',' + r2(50 + Math.sin(a) * r * 0.92);
  }
  return d;
})();
const star = (() => {
  const pts = [0, 2, 4, 1, 3, 0].map((k, i) => { const a = -Math.PI / 2 + (k * Math.PI * 2) / 5 + (i === 5 ? 0.12 : 0); const r = 44 + (i % 2 ? -3 : 2); return [50 + Math.cos(a) * r, 52 + Math.sin(a) * r]; });
  return 'M' + pts.map((p) => r2(p[0]) + ',' + r2(p[1])).join('L');
})();
const doodles = [
  { k: 'spiral', d: [spiral] },
  { k: 'star', d: [star] },
  { k: 'cube', d: ['M18,42 L60,40 L62,82 L20,83 Z', 'M34,24 L77,23 L78,64 L62,82', 'M18,42 L34,24 M60,40 L77,23'] },
  { k: 'code', d: ['M32,28 L12,51 L31,73', 'M68,28 L88,50 L69,72', 'M58,18 L43,82'] },
  { k: 'loop', d: ['M6,84 C26,40 62,92 56,56 C50,24 78,30 92,14', 'M92,14 L79,17 M92,14 L89,28'] },
  { k: 'spark', d: ['M50,8 L50,92', 'M8,50 L92,50', 'M22,22 L78,78', 'M78,22 L22,78'] },
  { k: 'zig', d: ['M4,58 L14,36 L24,62 L34,38 L44,64 L54,37 L64,62 L74,40 L84,60 L96,44'] },
];
---
<section class="block block--about about" id="about" data-theme="about" data-block="about">
  <div class="about__margins" aria-hidden="true">
    <svg class="about__ring-stain" viewBox="0 0 200 200" data-about-stain><circle cx="100" cy="100" r="78" /><circle cx="100" cy="100" r="70" /><path d="M168,140 C176,150 178,160 170,164 C162,166 160,154 168,140 Z" /></svg>
    {doodles.map((g) => <svg class={`about__mg about__mg--${g.k}`} viewBox="0 0 100 100">{g.d.map((d) => <path d={d} data-about-mg />)}</svg>)}
  </div>
  <div class="block__inner container about__grid">
    <div class="about__desk" data-about-desk aria-hidden="true"></div>

    <!-- лист из тетради в клетку под текстом: прихвачен скотчем, край оторван -->
    <div class="about__sheet" aria-hidden="true" data-about-sheet>
      <span class="about__sheet-shade"></span><span class="about__sheet-paper"></span>
      <span class="about__sheet-tape about__sheet-tape--a" data-about-sheet-tape></span><span class="about__sheet-tape about__sheet-tape--b" data-about-sheet-tape></span>
    </div>
    <div class="about__text">
      <div class="about__head">
        <h2 class="block__title about__title" aria-label={d.about.title} data-about-title>
          {words.map((w, wi) => (
            <Fragment>
              {wi > 0 && ' '}
              <span class="about__w" aria-hidden="true">
                {wi === 0 ? (
                  <Fragment>
                    <span class="about__capbox" data-about-capbox><span class="about__m"><span class="about__ch about__cap" data-about-cap>{w.slice(0, 1)}</span></span><svg class="about__ring" aria-hidden="true"><path data-about-ring d="" /></svg></span>
                    {w.length > 1 && <span class="about__m">{[...w.slice(1)].map((c) => <span class="about__ch">{c}</span>)}</span>}
                  </Fragment>
                ) : (
                  <span class="about__m">{[...w].map((c) => <span class="about__ch">{c}</span>)}</span>
                )}
              </span>
            </Fragment>
          ))}
        </h2>
        <button type="button" class="about__sticker about__sticker--round" data-about-sticker data-drag data-keys aria-label={stRound} aria-describedby="about-hint">
          <span class="about__st-in">
            <span class="about__st-body">
              <svg class="about__st-shape" viewBox="0 0 100 100" aria-hidden="true"><path class="about__st-shadow" d={round} /><path class="about__st-fill" d={round} /><path class="about__st-line" d={roundIn} /></svg>
              <span class="about__st-text">{words2(stRound).map((x) => <Fragment>{x.sp && ' '}{x.nw ? <span class="about__nw">{x.w}</span> : x.w}</Fragment>)}</span>
            </span>
          </span>
        </button>
        <p class="about__hint" id="about-hint"><span class="about__hint-t" data-about-hint>{ui.hint}</span><span class="visually-hidden"> {ui.keys}</span><svg class="about__hint-arrow" viewBox="0 0 60 40" aria-hidden="true"><path data-about-hint-arrow d="M4,30 C14,12 32,4 52,12" /><path data-about-hint-arrow d="M52,12 L41,5 M52,12 L45,22" /></svg></p>
      </div>

      <p class="about__lead" data-about-lead>{leadA}{emph && <em class="about__em">{emph}</em>}{leadB}</p>

      <ul class="about__notes" data-about-notes>
        {d.about.notes.slice(0, 3).map((n, i) => (
          <li class={`about__note about__note--${i + 1}`} data-about-note-item>
            <span class="about__note-t" data-about-note>{n}</span>
            {i === 0 && <svg class="about__doodle about__doodle--double" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path data-about-doodle d="M4,7 C50,3 120,4 196,6 M12,15 C70,12 128,13 186,15" /></svg>}
            {i === 1 && <svg class="about__doodle about__doodle--wave" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true"><path data-about-doodle d="M3,10 C18,4 30,14 46,8 C62,2 74,13 90,8 C106,3 118,13 134,8 C150,3 162,12 178,7 C186,5 192,6 197,8" /></svg>}
            {i === 2 && <svg class="about__doodle about__doodle--loop" viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true"><path data-about-doodle d="M42,11 C92,4 156,2 183,8 C202,14 201,58 189,69 C168,80 60,82 18,75 C0,70 -1,22 14,12 C28,5 62,3 98,6" /></svg>}
          </li>
        ))}
      </ul>
      <svg class="about__links" aria-hidden="true">
        {[0, 1].map(() => <g data-about-link><path class="about__link-line" d="" /><path class="about__link-head" d="" /></g>)}
      </svg>
    </div>

    <div class="about__photo">
      <div class="about__drop" data-about-drop>
        <div class="about__sway">
          <figure class="about__polaroid" data-about-swing>
            <span class="about__tape" data-about-tape aria-hidden="true"></span>
            <div class="about__pic">
              {photo ? (
                <img src={`${base}/photo/${photo}`} alt={d.about.photoAlt} width="800" height="1000" loading="lazy" decoding="async" />
              ) : (
                <div class="about__ph" role="img" aria-label={d.hero.name}>
                  <span class="about__mono" aria-hidden="true">{initials}</span>
                </div>
              )}
              <span class="about__dev" data-about-dev aria-hidden="true"></span>
            </div>
            <figcaption class="about__name"><span class="about__name-t" data-about-write>{d.hero.name}</span><span class="about__aka" data-about-aka>{d.about.aka}</span></figcaption>
          </figure>
        </div>
      </div>
      <button type="button" class={`about__sticker about__sticker--oval${stOval.length <= 10 ? ' is-short' : ''}`} data-about-sticker data-drag data-keys aria-label={stOval} aria-describedby="about-hint">
        <span class="about__st-in">
          <span class="about__st-body">
            <svg class="about__st-shape" viewBox="0 0 100 62" aria-hidden="true"><ellipse class="about__st-shadow" cx="50" cy="31" rx="48" ry="29" /><ellipse class="about__st-fill" cx="50" cy="31" rx="48" ry="29" /><ellipse class="about__st-line" cx="50" cy="31" rx="43" ry="24.5" /></svg>
            <span class="about__st-text">{words2(stOval).map((x) => <Fragment>{x.sp && ' '}{x.nw ? <span class="about__nw">{x.w}</span> : x.w}</Fragment>)}</span>
          </span>
        </span>
      </button>
      <button type="button" class={`about__sticker about__sticker--scallop${stScallop.length > 10 ? ' is-long' : ''}`} data-about-sticker data-drag data-keys aria-label={stScallop} aria-describedby="about-hint">
        <span class="about__st-in">
          <span class="about__st-body">
            <svg class="about__st-shape" viewBox="0 0 100 100" aria-hidden="true"><path class="about__st-shadow" d={scallop} /><path class="about__st-fill" d={scallop} /></svg>
            <span class="about__st-text">{stScallop}</span>
          </span>
        </span>
      </button>
    </div>
  </div>
</section>
