---
import './contacts.css';
import { t, langPrefix, type Lang } from '../../i18n';
import { site } from '../../config';
import Footer from '../../components/Footer.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const policyHref = `${base}${langPrefix(lang)}/policy/`;
// каждое предложение подводки с новой строки, чтобы короткое слово не повисало в конце строки
const leadParts = d.contacts.lead.split(/(?<=\.)\s+/);

// Марка с зубцами: прямоугольник, по краям которого выкушены полукруги перфорации.
const stamp = (() => {
  const W = 56, H = 64, s = 8, r = 2.4;
  let p = 'M0 0';
  for (let c = s / 2; c < W; c += s) p += ` L${c - r} 0 A${r} ${r} 0 0 0 ${c + r} 0`;
  p += ` L${W} 0`;
  for (let c = s / 2; c < H; c += s) p += ` L${W} ${c - r} A${r} ${r} 0 0 0 ${W} ${c + r}`;
  p += ` L${W} ${H}`;
  for (let c = W - s / 2; c > 0; c -= s) p += ` L${c + r} ${H} A${r} ${r} 0 0 0 ${c - r} ${H}`;
  p += ` L0 ${H}`;
  for (let c = H - s / 2; c > 0; c -= s) p += ` L0 ${c + r} A${r} ${r} 0 0 0 0 ${c - r}`;
  return p + ' Z';
})();
// Бумажный самолётик носом вправо, центр в 0 0: верхнее крыло, нижнее крыло, сгиб.
const planeTop = 'M18 0 L-17 -12 L-7 1 Z';
const planeLow = 'M18 0 L-7 1 L-12 12 Z';
const planeKeel = 'M18 0 L-7 1';
// облака: плоское дно и шапка из нескольких горбов
const cloudA = 'M8 58 C6 47 16 40 27 44 C29 29 47 22 58 32 C64 20 86 21 90 37 C103 34 114 45 110 58 Z';
// волнистая черта под полем при фокусе и галочка: ровная, чуть выгнутая, внутри квадрата
const wave = 'M0 4 ' + 'q6 -2.6 12 0 t12 0 '.repeat(12).trim() + ' t12 0';
const tick = 'M6.6 12.4 L10.3 16.1 L17.6 8.2';
const kinds = {
  tg: { type: 'text', mode: 'text', auto: 'off' },
  email: { type: 'email', mode: 'email', auto: 'email' },
  phone: { type: 'tel', mode: 'tel', auto: 'tel' },
} as const;
const cloudB = 'M6 58 C5 50 13 45 21 48 C24 37 38 33 46 40 C52 30 66 30 70 40 C78 28 98 30 100 44 C110 43 116 52 113 58 Z';
---
<section class="block block--contacts contacts" id="contacts" data-theme="contacts" data-block="contacts">
  <!-- фон: облака, вырезанные из бумаги, плывут на разной высоте; ближние крупнее и быстрее -->
  <div class="contacts__clouds" aria-hidden="true">
    {[1, 2, 3, 4, 5, 6].map((i) => <svg class={`contacts__cloud contacts__cloud--${i}`} viewBox="0 0 120 64"><path d={i % 2 ? cloudA : cloudB} /></svg>)}
  </div>
  <svg class="contacts__sky" aria-hidden="true" data-sky>
    <path class="contacts__trail" data-trail />
    <g class="contacts__plane" data-plane>
      <path class="contacts__wing" d={planeTop} />
      <path class="contacts__wing contacts__wing--low" d={planeLow} />
      <path class="contacts__keel" d={planeKeel} />
    </g>
  </svg>
  <div class="block__inner container contacts__grid">
    <div class="contacts__head" data-head>
      <div class="contacts__sign">
        <h2 class="block__title contacts__title" data-title>{d.contacts.title}</h2>
        <svg class="contacts__swash" viewBox="0 0 400 44" preserveAspectRatio="none" aria-hidden="true">
          <path data-swash d="M6 22 C 70 12, 150 8, 236 12 S 360 22, 394 8" />
          <path data-swash d="M40 36 C 120 29, 220 27, 318 32" />
        </svg>
      </div>
      <p class="contacts__lead" data-lead>{leadParts.map((part, i) => <>{i > 0 && <br />}{part}</>)}</p>
    </div>

    <div class="contacts__letter" data-letter>
      <form class="contact-form" data-contact-form data-endpoint={site.formEndpoint} data-lang={lang}
        data-sending={d.contacts.sending} data-success={d.contacts.success} data-error={d.contacts.error}
        data-error-consent={d.contacts.errorConsent} data-error-empty={d.contacts.errorEmpty} data-error-contact={d.contacts.errorContact} novalidate aria-labelledby="cf-title" data-form>
        <div class="contact-form__top">
          <h3 class="contact-form__title" id="cf-title">{d.contacts.formTitle}</h3>
          <div class="contacts__stamp" aria-hidden="true">
            <svg class="contacts__stamp-paper" viewBox="-1 -1 58 66">
              <path class="contacts__stamp-edge" d={stamp} />
              <rect class="contacts__stamp-pic" x="6" y="6" width="44" height="52" />
              <path class="contacts__stamp-cloud" d="M11 46 q4 -5 8 0 q3 -4 7 0 M30 20 q4 -5 8 0 q3 -4 7 0" />
              <g transform="translate(29 33) rotate(-24) scale(.82)">
                <path class="contacts__stamp-wing" d={planeTop} />
                <path class="contacts__stamp-wing contacts__stamp-wing--low" d={planeLow} />
              </g>
            </svg>
            <svg class="contacts__postmark" viewBox="0 0 120 60" data-postmark>
              <circle cx="92" cy="30" r="24" />
              <circle cx="92" cy="30" r="18.5" />
              <path d="M2 18 q8 -5 16 0 t16 0 t16 0 t16 0" />
              <path d="M2 27 q8 -5 16 0 t16 0 t16 0 t16 0" />
              <path d="M2 36 q8 -5 16 0 t16 0 t16 0 t16 0" />
              <path d="M2 45 q8 -5 16 0 t16 0 t16 0 t16 0" />
            </svg>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="cf-name">{d.contacts.nameLabel}</label>
          <input class="field__input" id="cf-name" name="name" type="text" autocomplete="name" maxlength="120" placeholder={d.contacts.namePlaceholder} />
          <svg class="field__ink" viewBox="0 0 300 8" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d={wave} /></svg>
        </div>
        <!-- куда ответить: отмеченный способ открывает строку для своего контакта -->
        <div class="field reply" role="radiogroup" aria-labelledby="cf-reply" data-reply data-keys>
          <p class="field__label" id="cf-reply">{d.contacts.replyLabel}</p>
          <div class="reply__opts">
            {d.contacts.via.map((v, i) => (
              <label class="check">
                <input class="check__box" type="radio" name="via" value={v.id} checked={i === 0} aria-controls={`cf-${v.id}`} />
                <span class="check__mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={tick} /></svg></span>
                <span class="check__text">{v.label}</span>
              </label>
            ))}
          </div>
          {d.contacts.via.map((v, i) => (
            <div class="reply__line" class:list={[{ 'has-prefix': !!v.prefix }]} data-via={v.id} hidden={i !== 0}>
              {v.prefix && <span class="reply__prefix" aria-hidden="true">{v.prefix}</span>}
              <input class="field__input" id={`cf-${v.id}`} name={`c_${v.id}`} data-prefix={v.prefix} type={kinds[v.id].type} inputmode={kinds[v.id].mode} autocomplete={kinds[v.id].auto} maxlength="160" placeholder={v.placeholder} aria-label={v.label} />
              <svg class="field__ink" viewBox="0 0 300 8" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d={wave} /></svg>
            </div>
          ))}
        </div>
        <div class="field">
          <label class="field__label" for="cf-message">{d.contacts.messageLabel}</label>
          <textarea class="field__input field__textarea" id="cf-message" name="message" rows="3" maxlength="2000" required placeholder={d.contacts.messagePlaceholder}></textarea>
        </div>
        <div class="field field--hp" aria-hidden="true">
          <label for="cf-website">Website</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label class="check consent">
          <input class="check__box" type="checkbox" name="consent" required />
          <span class="check__mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={tick} /></svg></span>
          <span class="check__text">{d.contacts.consent} <a href={policyHref}>{d.contacts.consentLink}</a></span>
        </label>
        <div class="contact-form__actions">
          <button class="btn btn--primary contact-form__send" type="submit" data-magnetic="0.2">{d.contacts.submit}</button>
        </div>
        <p class="contact-form__status" id="cf-status" data-form-status role="status" aria-live="polite"></p>
      </form>
      <!-- клапан конверта и сгибы: видны, пока письмо не раскрылось -->
      <div class="contacts__flap" aria-hidden="true" data-flap>
        <svg viewBox="0 0 100 40" preserveAspectRatio="none"><path class="contacts__flap-back" d="M0 0 H100 L50 40 Z" /><path class="contacts__flap-edge" d="M0 0 L50 40 L100 0" /></svg>
        <span class="contacts__seal"></span>
      </div>
      <svg class="contacts__folds" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-folds><path d="M0 100 L50 52 L100 100" /></svg>
      <!-- письмо при отправке складывается в самолётик и улетает -->
      <svg class="contacts__send" aria-hidden="true" data-send>
        <defs>
          <pattern id="contacts-airmail" width="22" height="22" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="22" height="22" class="contacts__air-a" /><rect width="7" height="22" class="contacts__air-b" /><rect x="11" width="7" height="22" class="contacts__air-c" />
          </pattern>
        </defs>
        <path class="contacts__send-trail" data-send-trail />
        <g data-send-g><path class="contacts__send-sheet" data-send-sheet /><path class="contacts__send-fold" data-send-fold /></g>
      </svg>
    </div>
  </div>
  <Footer lang={lang} />
</section>
