---
import './services.css';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const items = d.services.items;
const nn = (n: number) => String(n).padStart(2, '0');
// Подписи только этого блока: меню, кнопка «дальше», колесо скидок и надписи внутри экранчиков.
const ui18n = {
  ru: {
    menu: 'Меню услуг', hint: 'наведите курсор или', next: 'Следующий пункт',
    game: 'Колесо скидок: нажмите, чтобы крутить',
    w: {
      bot: 'Запись', online: 'в сети', typing: 'печатает…', msg: 'Сообщение',
      ask: 'Хочу записаться', pick: 'Выберите время:', slots: ['12:00', '15:30', '18:30'], done: 'Готово! Жду вас в 18:30',
      nav: ['Обзор', 'Заказы', 'Клиенты', 'Отчёты'], kpi: ['Выручка', 'Заказы', 'Конверсия'], dec: ',',
      sales: 'Продажи', week: 'Неделя', toast: 'Новый заказ', st: ['новый', 'оплачен', 'в пути'], names: ['Анна', 'Илья', 'Мария', 'Олег'],
      tasks: 'Задачи', todo: ['Созвон', 'Счёт', 'Макет'], add: 'Релиз',
      promo: 'Скидка до 30%', spin: 'Крутить', code: 'Ваш промокод', copy: 'Скопировать', copied: 'Скопировано',
    },
  },
  en: {
    menu: 'Services menu', hint: 'hover or', next: 'Next item',
    game: 'Discount wheel: press to spin',
    w: {
      bot: 'Booking', online: 'online', typing: 'typing…', msg: 'Message',
      ask: 'I want to book', pick: 'Pick a time:', slots: ['12:00', '15:30', '18:30'], done: 'Done! See you at 18:30',
      nav: ['Overview', 'Orders', 'Clients', 'Reports'], kpi: ['Revenue', 'Orders', 'Conversion'], dec: '.',
      sales: 'Sales', week: 'Week', toast: 'New order', st: ['new', 'paid', 'shipped'], names: ['Anna', 'Ilya', 'Maria', 'Oleg'],
      tasks: 'Tasks', todo: ['Call', 'Invoice', 'Mockup'], add: 'Release',
      promo: 'Up to 30% off', spin: 'Spin', code: 'Your promo code', copy: 'Copy', copied: 'Copied',
    },
  },
}[lang];
// сцены экранчика по порядку пунктов меню
const widgets = ['sites', 'dash', 'devices', 'bots', 'cube', 'promo'];

// Фон: уровень платформера за меню. Пиксельные облака, холмы и земля рисуются здесь в SVG
// (квадраты по 8 px), в CSS они повторяются по горизонтали и едут с разной скоростью.
const svg = (w: number, h: number, body: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${h}' shape-rendering='crispEdges'>${body}</svg>`)}")`;
const R = (x: number, y: number, w: number, h: number, f: string) => `<rect x='${x}' y='${y}' width='${w}' height='${h}' fill='${f}'/>`;
// облако: ступенчатая шапка из рядов, у каждого ряда своя ширина
const cloud = (x: number, y: number, rows: number[], f: string, edge: string) => {
  const wMax = Math.max(...rows);
  return rows.map((w, i) => R(x + ((wMax - w) / 2) * 8, y + i * 8, w * 8, 8, i === rows.length - 1 ? edge : f)).join('');
};
const clouds = svg(560, 72,
  cloud(40, 8, [4, 8, 12, 12], '#E2EECB', '#D3E4B4') + cloud(330, 32, [3, 6, 8], '#E2EECB', '#D3E4B4'));
// холм: ступени по 8 px, чем выше, тем уже
const hill = (cx: number, base: number, half: number, steps: number, f: string) =>
  Array.from({ length: steps }, (_, i) => { const hw = Math.round((half * (steps - i)) / steps / 8) * 8; return R(cx - hw, base - (i + 1) * 8, hw * 2, 8, f); }).join('');
const hills = svg(640, 128,
  hill(150, 128, 150, 12, '#BCD394') + hill(470, 128, 110, 8, '#BCD394') + hill(300, 128, 90, 5, '#B2CB89'));
const ground = svg(32, 48,
  R(0, 0, 32, 8, '#97B36F') + R(0, 8, 32, 40, '#B3CB8A') + R(0, 8, 32, 2, '#A3BE7B') + R(0, 27, 32, 2, '#A3BE7B') + R(15, 10, 2, 17, '#A3BE7B') + R(0, 29, 2, 19, '#A3BE7B') + R(8, 0, 8, 4, '#A6C17E') + R(24, 0, 4, 4, '#A6C17E'));
const world = `--w-clouds: ${clouds}; --w-hills: ${hills}; --w-ground: ${ground};`;
---
<section class="block block--services services" id="services" data-theme="services" data-block="services" data-svc-ui={JSON.stringify(ui18n.w)}>
  <div class="services__world" style={world} aria-hidden="true"><i class="services__clouds"></i><i class="services__hills"></i><i class="services__ground"></i></div>
  <div class="block__inner container services__grid">
    <h2 class="block__title services__title" data-services-title>{d.services.title}</h2>

    <div class="services__menu" role="group" aria-label={ui18n.menu} data-keys data-services-menu>
      <div class="services__track" data-services-track>
        <span class="services__band" aria-hidden="true" data-services-band></span>
        <span class="services__marker" aria-hidden="true" data-services-marker>
          <span class="services__mk-drop" data-services-mkdrop>
            <span class="services__mk-pop" data-services-mkpop>
              <svg viewBox="0 0 6 11" shape-rendering="crispEdges"><path d="M0 0h1v11H0zM1 1h1v9H1zM2 2h1v7H2zM3 3h1v5H3zM4 4h1v3H4zM5 5h1v1H5z" fill="currentColor" /></svg>
            </span>
          </span>
        </span>
        <ul class="services__list" data-services-list>
          {items.map((item, i) => (
            <li class="services__item" class:list={[{ 'is-active': i === 0 }]} data-services-item>
              <button class="services__btn" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-services-btn>
                <span class="services__row" data-services-row>
                  <span class="services__num" aria-hidden="true">{nn(i + 1)}</span>
                  <span class="services__name">{item.title}</span>
                </span>
              </button>
              <p class="services__desc visually-hidden">{item.text}</p>
            </li>
          ))}
        </ul>
        <!-- копия списка тёмным цветом: видна только внутри полосы выделения, поэтому текст под полосой всегда инвертирован -->
        <ul class="services__list services__list--inv" aria-hidden="true" data-services-inv>
          {items.map((item, i) => (
            <li class="services__item" class:list={[{ 'is-active': i === 0 }]}>
              <span class="services__btn">
                <span class="services__row">
                  <span class="services__num">{nn(i + 1)}</span>
                  <span class="services__name">{item.title}</span>
                </span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <p class="services__hint" aria-hidden="true" data-services-hint>{ui18n.hint}
        <kbd><svg viewBox="0 0 7 4" shape-rendering="crispEdges"><path d="M3 0h1v1H3zM2 1h3v1H2zM1 2h5v1H1zM0 3h7v1H0z" fill="currentColor" /></svg></kbd>
        <kbd><svg viewBox="0 0 7 4" shape-rendering="crispEdges"><path d="M0 0h7v1H0zM1 1h5v1H1zM2 2h3v1H2zM3 3h1v1H3z" fill="currentColor" /></svg></kbd>
      </p>
    </div>

    <div class="services__dialog" data-services-dialog>
      <span class="services__shade" aria-hidden="true"></span>
      <div class="services__screen" data-services-screen>
        <div class="services__power" data-services-power>
          <div class="services__tube" data-services-tube>
            {widgets.map((w, i) => (
              <div class={`svc-w svc-w--${w}`} class:list={[{ 'is-shown': i === 0 }]} aria-hidden={w === 'promo' ? undefined : 'true'} data-svc-w={w}>
                {w === 'promo' && (
                  <button class="svc-game__hit" type="button" aria-label={ui18n.game} data-svc-hit></button>
                )}
              </div>
            ))}
          </div>
        </div>
        <!-- «каналы» в углу экрана, как у телевизора: какой пункт показан и сколько ему осталось -->
        <span class="services__pips" aria-hidden="true" data-services-pips>
          {items.map((_, i) => <i class:list={[{ 'is-on': i === 0 }]}><b></b></i>)}
        </span>
        <span class="services__scan" aria-hidden="true"></span>
        <span class="services__flash" aria-hidden="true" data-services-flash></span>
      </div>

      <div class="services__say" aria-hidden="true">
        <p class="services__dname">
          {items.map((item) => <span class="services__ghost">{item.title}</span>)}
          <span class="services__live" data-services-name>{items[0].title}</span>
        </p>
        <p class="services__text">
          {items.map((item) => <span class="services__ghost">{item.text}<i class="services__caret"></i></span>)}
          <span class="services__live"><span data-services-text>{items[0].text}</span><i class="services__caret"></i></span>
        </p>
      </div>
      <button class="services__next" type="button" aria-label={ui18n.next} data-services-next>
        <svg viewBox="0 0 9 5" shape-rendering="crispEdges" aria-hidden="true"><path d="M0 0h9v1H0zM1 1h7v1H1zM2 2h5v1H2zM3 3h3v1H3zM4 4h1v1H4z" fill="currentColor" /></svg>
      </button>
    </div>
  </div>
</section>
