---
import './works.css';
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getCollection('work', (e) => e.id.endsWith(`/${lang}`) && !e.data.draft);
const works = all.sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

// Акцент по проекту: номер в счётчике и подсветка точки. Нет записи: остаётся тема.
const ACCENT: Record<string, string> = { perfume: '#F2B44C', 'ugli-bot': '#F0763E', pena: '#A9CF8E' };

// Работы стоят на цилиндре: у каждой короткое видео (works.ts крутит цилиндр, переднее видео играет).
// Фон блока = неподвижная наклонная плоскость из скриншотов всех работ (уменьшенные варианты -800).
const has = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const small = (src: string) => { const s = src.replace(/\.webp$/, '-800.webp'); return s !== src && has(s) ? s : null; };
const items = works.filter((w) => w.data.video).map((w) => {
  const slug = w.id.split('/')[0];
  const v = w.data.video!;
  const desk = w.data.media.filter((m) => !m.portrait && m.kind === 'image').map((m) => base + (small(m.src) ?? m.src));
  const phones = w.data.media.filter((m) => m.portrait && m.kind === 'image').map((m) => base + m.src);
  // на цилиндре без видео стоит обложка работы (кадр, где сцена собрана), а не первый, часто пустой кадр ролика
  return { w: w.data, slug, desk, phones, cover: base + w.data.cover, video: { mp4: base + v.mp4, webm: base + v.webm, poster: base + v.poster }, accent: ACCENT[slug] ?? '' };
});
const tiles = JSON.stringify([
  ...items.flatMap((it) => it.desk.map((src) => ({ src, portrait: false }))),
  ...items.flatMap((it) => it.phones.map((src) => ({ src, portrait: true }))),
]);
const ring = JSON.stringify(items.map((it) => ({ poster: it.cover, accent: it.accent })));
const pad = (n: number) => String(n).padStart(2, '0');
const label = (s: string, n: number, total: number) => s.replace('{n}', String(n)).replace('{total}', String(total));
const arrow = (dir: 'l' | 'r') => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${dir === 'l' ? 'M14.5 6 8.5 12l6 6' : 'M9.5 6l6 6-6 6'}" /></svg>`;
const first = items[0];
---
<section class="block block--works works" id="works" data-theme="works" data-block="works" style={first?.accent ? `--accent:${first.accent}` : undefined}
  data-works-ring={ring}>
  <div class="works__field" aria-hidden="true">
    <div class="works__plane" data-works-plane data-works-tiles={tiles}>
      <div class="works__spin" data-works-spin>
        <div class="works__strip" data-works-strip></div>
      </div>
    </div>
  </div>
  <div class="works__veil" aria-hidden="true"></div>
  <canvas class="works__gl" aria-hidden="true" data-works-gl></canvas>

  <div class="block__inner container works__inner">
    <h2 class="works__title" data-works-title>{d.works.title}</h2>

    <!-- место цилиндра: здесь ловятся свайп, протаскивание и клик; без WebGL здесь же плоское окно с видео -->
    <div class="works__ring" role="group" aria-roledescription={d.works.carousel} aria-label={d.works.title} data-works-area>
      <div class="works__flat" data-works-flat>
        {items.map((it, k) => (
          <video class:list={['works__vid', { 'is-on': k === 0 }]} muted playsinline disablepictureinpicture preload={k === 0 ? 'metadata' : 'none'}
            poster={it.video.poster} width="1600" height="900" aria-label={`${d.works.video}: ${it.w.title}`} data-works-video={k}>
            <source src={it.video.webm} type="video/webm" />
            <source src={it.video.mp4} type="video/mp4" />
          </video>
        ))}
      </div>
    </div>

    <div class="works__card" data-works-card>
      <p class="works__count" aria-live="polite">
        <span class="visually-hidden" data-works-count-sr>{label(d.works.project, 1, items.length)}</span>
        <span aria-hidden="true"><b data-works-count-n>01</b> / {pad(items.length)}</span>
      </p>
      {items.map((it, k) => (
        <div class="works__proj" data-works-proj={k} hidden={k !== 0}>
          <h3 class="works__name" data-works-name>{it.w.title}</h3>
          <p class="works__sub" data-works-part>{it.w.subtitle}</p>
          <p class="works__sum" data-works-part>{it.w.summary}</p>
          <p class="works__meta" data-works-part><span>{it.w.year}</span><span>{it.w.stack.join(', ')}</span>{it.w.concept && <span class="works__concept">{d.works.concept}</span>}</p>
        </div>
      ))}
      <div class="works__nav" data-works-nav>
        <button type="button" class="works__step" aria-label={d.works.prev} data-works-step="-1" set:html={arrow('l')} />
        <div class="works__idx" role="group" aria-label={d.works.title}>
          {items.map((it, k) => (
            <button type="button" class="works__dot" aria-label={`${label(d.works.project, k + 1, items.length)}: ${it.w.title}`} aria-current={k === 0 ? 'true' : 'false'}
              style={it.accent ? `--dot:${it.accent}` : undefined} data-works-dot={k}><span>{pad(k + 1)}</span><i></i></button>
          ))}
        </div>
        <button type="button" class="works__step" aria-label={d.works.next} data-works-step="1" set:html={arrow('r')} />
      </div>
      <a class="works__yours" href="#contacts" data-works-yours>
        <span class="works__yours-q">{d.works.yours}</span><span class="works__write">{d.hero.ctaContact} <span class="works__arrow" aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
</section>
