---
import './works.css';
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { t, langPrefix, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getCollection('work', (e) => e.id.endsWith(`/${lang}`) && !e.data.draft);
const works = all.sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

// Акцент по проекту: красится кнопка при наведении на окно и заполнение точек. Нет записи: остаётся тема.
const ACCENT: Record<string, string> = { perfume: '#F2B44C' };

// Поле экранов: окно показывает горизонтальные кадры активной работы, телефон рядом вертикальные,
// а наклонная плоскость за ними собрана из экранов всех работ (уменьшенные варианты -800).
const has = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const small = (src: string) => { const s = src.replace(/\.webp$/, '-800.webp'); return s !== src && has(s) ? s : null; };
const items = works.map((w) => {
  const slug = w.id.split('/')[0];
  const shots = w.data.media.filter((m) => !m.portrait && m.kind === 'image');
  const desk = (shots.length ? shots : [{ src: w.data.cover, alt: w.data.coverAlt }]).map((m) => {
    const s = small(m.src);
    return { src: base + m.src, srcset: s ? `${base + s} 800w, ${base + m.src} 1600w` : undefined, tile: base + (s ?? m.src), alt: m.alt };
  });
  const phones = w.data.media.filter((m) => m.portrait && m.kind === 'image').map((m) => ({ src: base + m.src, alt: m.alt }));
  return { w: w.data, slug, href: `${base}${langPrefix(lang)}/work/${slug}/`, desk, phones, accent: ACCENT[slug] };
});
const first = items[0];
const tiles = JSON.stringify([
  ...items.flatMap((it) => it.desk.map((m) => ({ src: m.tile, portrait: false }))),
  ...items.flatMap((it) => it.phones.map((m) => ({ src: m.src, portrait: true }))),
]);
const screenLabel = (i: number, n: number) => d.works.screen.replace('{n}', String(i + 1)).replace('{total}', String(n));
---
<section class="block block--works works" id="works" data-theme="works" data-block="works" style={first?.accent ? `--accent:${first.accent}` : undefined}
  data-works-accents={JSON.stringify(items.map((it) => it.accent ?? ''))} data-works-slugs={JSON.stringify(items.map((it) => it.slug))}>
  <div class="works__field" aria-hidden="true" data-works-field>
    <div class="works__drift" data-works-drift>
      <div class="works__plane" data-works-plane data-works-tiles={tiles}>
        <div class="works__spin" data-works-spin>
          <div class="works__strip" data-works-strip></div>
        </div>
      </div>
    </div>
  </div>
  <div class="works__veil" aria-hidden="true"></div>

  <div class="block__inner container works__inner">
    <h2 class="works__title" data-works-title>{d.works.title}</h2>

    <div class="works__card" data-works-card>
      {items.map((it, k) => (
        <div class="works__proj" data-works-proj={k} hidden={k !== 0}>
          <h3 class="works__name" data-works-name>{it.w.title}</h3>
          <p class="works__sub" data-works-sub>{it.w.subtitle}</p>
          <p class="works__meta" data-works-meta><span>{it.w.year}</span><span>{it.w.stack.join(', ')}</span></p>
          <a class="works__open" href={it.href} data-works-open>
            <span>{d.works.open}</span><span class="works__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      ))}
      <ul class:list={['works__list', { 'is-many': items.length > 5 }]} data-works-list role="list">
        {items.map((it, k) => (
          <li class="works__row" data-works-row={k} hidden={k === 0}>
            <button type="button" class="works__pick" data-works-pick={k}>
              <span class="works__pick-name">{it.w.title}</span><span class="works__pick-year">{it.w.year}</span>
            </button>
          </li>
        ))}
        <li class="works__row works__row--yours">
          <a class="works__yours" href="#contacts" aria-label={`${d.works.yours}: ${d.hero.ctaContact.toLowerCase()}`} data-works-yours>
            <span class="works__type" aria-hidden="true"><span class="works__ghost" data-works-ghost>{d.works.yours}</span><i class="works__caret" data-works-caret></i></span>
            <span class="works__write" aria-hidden="true">{d.hero.ctaContact} <span class="works__arrow">→</span></span>
          </a>
        </li>
      </ul>
    </div>

    {first && (
      <div class="works__stage" data-works-stage>
        <div class="works__win" role="group" aria-roledescription={d.works.carousel} aria-label={d.works.screens} data-works-win>
          <a class="works__desk" href={first.href} tabindex="-1" draggable="false" aria-label={`${d.works.open}: ${first.w.title}`}
             transition:name={`work-${first.slug}`} data-works-desk>
            <span class="works__zoom">
              {items.map((it, k) => it.desk.map((m, i) => (
                <img class:list={['works__shot', { 'is-on': k === 0 && i === 0 }]} src={m.src} srcset={m.srcset} sizes="(min-width: 761px) 60vw, 100vw"
                  alt={m.alt} width="1600" height="900" decoding="async" loading={k === 0 && i === 0 ? 'eager' : 'lazy'} draggable="false"
                  hidden={k !== 0} aria-hidden={k === 0 && i === 0 ? undefined : 'true'} data-works-shot={k} />
              )))}
            </span>
          </a>
          <span class="works__phone" aria-hidden="true" hidden={!first.phones.length} data-works-phone>
            {items.map((it, k) => it.phones.map((m, i) => (
              <img class:list={['works__pshot', { 'is-on': k === 0 && i === 0 }]} src={m.src} alt="" width="780" height="1688" decoding="async"
                loading={k === 0 && i === 0 ? 'eager' : 'lazy'} draggable="false" hidden={k !== 0} data-works-pshot={k} />
            )))}
          </span>
        </div>
        {items.map((it, k) => (
          <div class="works__ticks" data-works-ticks={k} hidden={k !== 0}>
            {it.desk.map((_, i) => (
              <button type="button" class="works__tick" tabindex={i ? -1 : 0} aria-label={screenLabel(i, it.desk.length)}
                aria-current={i === 0 ? 'true' : 'false'} data-works-tick><i></i></button>
            ))}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
