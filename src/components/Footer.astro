---
import { t, langPrefix, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="site-footer">
  <a class="site-footer__policy" href={`${base}${langPrefix(lang)}/policy/`}>{d.contacts.policy}</a>
</footer>
