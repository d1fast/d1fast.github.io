---
import { t, langPrefix, type Lang } from '../i18n';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}${langPrefix(lang)}/`;
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const switchHref = `${base}${langPrefix(other)}${path}`;
const items = [
  ['services', d.nav.services], ['works', d.nav.works], ['process', d.nav.process], ['contacts', d.nav.contacts],
];
---
<header class="site-header" data-header>
  <!-- имя слева, на месте знака сайта: видно на каждом блоке и ведёт на первый экран -->
  <a class="site-header__name" href={home}>{d.hero.name}</a>
  <nav class="site-header__nav" aria-label={lang === 'ru' ? 'Разделы' : 'Sections'}>
    {items.map(([id, label]) => <a href={`${home}#${id}`} data-scramble>{lang === 'en' ? label.toLowerCase().replace(/\bi\b/g, 'I') : label}</a>)}
  </nav>
  <a class="site-header__lang" href={switchHref} hreflang={other} lang={other} title={d.nav.langSwitchTitle} data-magnetic="0.25">{d.nav.langSwitch}</a>
</header>
