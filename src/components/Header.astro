---
import { t, langPrefix, type Lang } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const d = t(lang), base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}${langPrefix(lang)}/`;
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const switchPath = path === '/404/' ? '/' : path;
---
<header class="site-header">
  <a class="site-header__brand" href={home} aria-label={lang === 'ru' ? 'd1fast, на главную' : 'd1fast, home'}>d1fast<span aria-hidden="true">*</span></a>
  <button class="light-switch" type="button" data-light-shift aria-label={d.portfolio.light} title={d.portfolio.light}><Icon name="sun" /></button>
  <nav class="site-header__nav" aria-label={lang === 'ru' ? 'Навигация' : 'Navigation'}>
    <a class="header-link" href={`${home}#about`} data-open-view="about">{d.portfolio.about}</a>
    <a class="text-button header-contact" href={`${home}#contact`} data-open-view="contact"><span class="header-contact__long">{d.portfolio.contact}</span><span class="header-contact__short">{d.portfolio.contactShort}</span><Icon /></a>
  </nav>
  <a class="site-header__lang" href={`${base}${langPrefix(other)}${switchPath}`} hreflang={other} lang={other} title={d.nav.langSwitchTitle}>{d.nav.langSwitch}</a>
</header>
