---
// Первый экран, чёрно-белый: чёрный экран, знак «d1fast ©», потом фразы стеклянными буквами на цилиндре
// (src/scripts/hero.ts, hero/glass.ts). Последняя фраза остаётся заголовком по центру, под ней строка и кнопки.
// Без скрипта и без WebGL виден тот же заголовок обычным текстом. Для поиска и скринридеров есть обычный h1.
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const beats = d.hero.beats;
const last = beats[beats.length - 1].map((l) => l.replace(/\|/g, ' '));
---
<section class="block hero" id="top" data-theme="hero" data-block="hero" data-hero
  data-beats={JSON.stringify(beats)} data-photo={`${base}/photo/me-bw.webp`}>
  <canvas class="hero__gl" aria-hidden="true" data-hero-gl></canvas>
  <p class="hero__mark" aria-hidden="true" data-hero-mark>{d.hero.nick}<span>©</span></p>

  <div class="container hero__inner">
    <h1 class="visually-hidden">{d.hero.h1}</h1>
    <!-- место заголовка: сюда встаёт последняя стеклянная фраза; без WebGL здесь она же текстом -->
    <div class="hero__slot" data-hero-slot>
      <p class="hero__title" aria-hidden="true" data-hero-title>{last.map((l) => <span>{l}</span>)}</p>
    </div>
    <p class="hero__sub" data-hero-sub>{d.hero.sub}</p>
    <div class="hero__cta" data-hero-cta>
      <a class="btn btn--primary" href="#contacts" data-magnetic>{d.hero.ctaContact}</a>
      <a class="btn btn--ghost" href="#works" data-magnetic="0.2">{d.hero.ctaWorks}</a>
    </div>
  </div>
</section>
