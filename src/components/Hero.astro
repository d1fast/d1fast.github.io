---
// Первый экран-воронка. Слева в трёх строках-прорезях сменяются вопросы, справа объёмное слово того,
// о чём спросили, и у каждого вопроса своя палитра (hero.ts, hero/type3d.ts, hero/palettes.ts).
// Потом сомнение, ответ, кто я и кнопки. Без скрипта виден ответ, текст обо мне, кнопки и плоская стопка слов.
// Для поиска и скринридеров есть обычный h1.
import { t, type Lang } from '../i18n';
import geo from '../scripts/hero/geologica-800.json';
import { STACK_FACES, ANSWER } from '../scripts/hero/palettes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
/** строка заголовка: «~» в начале приглушает её, *…* выделяет акцентом */
const line = (s: string) => ({ muted: s.startsWith('~'), html: esc(s.replace(/^~/, '')).replace(/\*(.+?)\*/g, '<em>$1</em>') });
/** ширина слова в em по ширинам знаков Geologica 800: плоская стопка ставит все слова одной ширины */
const glyphs = geo.glyphs as Record<string, { ha: number }>;
const em = (w: string) => [...w].reduce((a, c) => a + (glyphs[c]?.ha ?? 1200), 0) / geo.resolution;
const ems = d.hero.ask.map((a) => em(a.word));
const sum = ems.reduce((a, e) => a + 0.9 / e, 0);
const states = { ask: d.hero.ask.map((a) => ({ lines: a.lines.map(line), word: a.word })), doubt: d.hero.doubt.map(line), answer: d.hero.answer.map(line) };
---
<section class="block hero" id="top" data-theme="hero" data-block="hero" data-hero data-states={JSON.stringify(states)}>
  <div class="hero__floodbox" aria-hidden="true"><i class="hero__flood" data-hero-flood></i></div>
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 class="visually-hidden">{d.hero.h1}</h1>
      <p class="hero__say" aria-hidden="true" data-hero-say>
        {states.answer.map((l) => (
          <span class="hero__ln" data-hero-ln><span class:list={['hero__w', { 'is-m': l.muted }]} set:html={l.html} /><span class="hero__w" /></span>
        ))}
      </p>
      <div class="hero__end">
        <p class="hero__sub" data-hero-sub>{d.hero.sub}</p>
        <div class="hero__cta" data-hero-cta>
          <a class="btn btn--primary" href="#contacts" data-magnetic>{d.hero.ctaContact}</a>
          <a class="btn btn--ghost" href="#works" data-magnetic="0.2">{d.hero.ctaWorks}</a>
        </div>
        <button class="hero__skip" type="button" data-hero-skip hidden>{d.hero.skip} <span aria-hidden="true">→</span></button>
      </div>
    </div>
    <div class="hero__stage" aria-hidden="true">
      <canvas class="hero__gl" data-hero-gl></canvas>
      <p class="hero__flat" style={`--sum:${sum.toFixed(4)};--side:${ANSWER.side}`}>{d.hero.ask.map((a, i) => <span style={`--em:${ems[i].toFixed(4)};--face:${STACK_FACES[i]}`}>{a.word}</span>)}</p>
    </div>
  </div>
</section>
