---
interface Props { name?: 'arrow' | 'close' | 'play' | 'pause' | 'expand' | 'plus' | 'chevron'; class?: string }
const { name = 'arrow', class: cls } = Astro.props;
const paths = {
  arrow: 'M4 20 20 4M4 4h16v16', close: 'm6 6 12 12M18 6 6 18',
  play: 'm9 5 11 7-11 7Z', pause: 'M8 5v14M16 5v14',
  expand: 'M9 3H3v6m12-6h6v6M3 15v6h6m6 0h6v-6', plus: 'M12 4v16M4 12h16', chevron: 'm5 9 7 7 7-7',
};
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
