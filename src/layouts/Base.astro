---
import '../styles/fonts.generated.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/pages.css';
import Footer from '../components/Footer.astro';
import { t, langPrefix, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Путь страницы без языкового префикса и без base, например '/' или '/work/perfume/'. */
  path: string;
  ogImage?: string;
  /** Размеры картинки превью, если она не стандартная 1200x630. */
  ogWidth?: number;
  ogHeight?: number;
  noindex?: boolean;
  /** У главной собственный компактный подвал. */
  footer?: boolean;
  /** Главная с общим фоном и окнами. */
  portfolio?: boolean;
}
const { lang, path, noindex = false, footer = true, portfolio = false, ogWidth = 1200, ogHeight = 630 } = Astro.props;
const d = t(lang);
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site ? Astro.site.origin : '';
const url = (l: Lang, p: string) => `${origin}${base}${langPrefix(l)}${p}`;
const canonical = url(lang, path);
const ogImage = `${origin}${base}${Astro.props.ogImage ?? (lang === 'en' ? '/og-en.png' : '/og.png')}`;
const other = lang === 'ru' ? 'en' : 'ru';
---
<!doctype html>
<html lang={d.htmlLang} data-theme="studio" class:list={[{ 'is-portfolio': portfolio }]}>
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ base, path, lang }}>
      (() => {
        if (path === '/404/') return;
        const preferred = (navigator.languages?.length ? navigator.languages : [navigator.language])
          .map(value => value.toLowerCase().split('-')[0]).find(value => value === 'ru' || value === 'en') || 'en';
        if (preferred !== lang) location.replace(base + (preferred === 'en' ? '/en' : '') + path + location.search + location.hash);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- цвета сайта заданы вручную: запрещаем браузеру и расширениям перекрашивать светлые блоки в тёмные -->
    <meta name="color-scheme" content="only light" />
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l === 'ru' ? 'ru' : 'en'} href={url(l, path)} />)}
    <link rel="alternate" hreflang="x-default" href={url('ru', path)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="d1fast" />
    <meta property="og:title" content={Astro.props.title ?? d.meta.ogTitle} />
    <meta property="og:description" content={Astro.props.description ?? d.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={other === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#96B0BF" />
    <link rel="icon" href={`${base}/favicon-16.png?v=6`} sizes="16x16" type="image/png" />
    <link rel="icon" href={`${base}/favicon-32.png?v=6`} sizes="32x32" type="image/png" />
    <link rel="icon" href={`${base}/favicon.svg?v=6`} sizes="any" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="preload" href={`${base}/fonts/golos-ui-${lang === 'ru' ? 'cyr' : 'lat'}.woff2`} as="font" type="font/woff2" crossorigin />
    {portfolio && <link rel="preload" href={`${base}/fonts/yeseva-${lang === 'ru' ? 'cyr' : 'lat'}.woff2`} as="font" type="font/woff2" crossorigin />}
    <script is:inline>
      document.documentElement.classList.add('js');
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: lang === 'ru' ? 'Савелий Лопатин' : 'Saveliy Lopatin',
      alternateName: 'd1fast',
      url: url(lang, '/'),
      jobTitle: lang === 'ru' ? 'Веб-разработчик' : 'Web developer',
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skipToContent}</a>
    <main id="main">
      <slot />
    </main>
    {footer && <Footer lang={lang} />}
    <script src="../scripts/main.ts"></script>
  </body>
</html>
