---
import '../styles/fonts.generated.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/sections.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, langPrefix, langs, type Lang } from '../i18n';
import { site } from '../config';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Путь страницы без языкового префикса и без base, например '/' или '/work/perfume/'. */
  path: string;
  ogImage?: string;
  /** Размеры картинки превью, если она не стандартная 1200x630. */
  ogWidth?: number;
  ogHeight?: number;
  noindex?: boolean;
  theme?: string;
  /** Главная рисует подвал внутри последнего блока. */
  footer?: boolean;
  /** Посекционный скролл на главной. */
  snap?: boolean;
}
const { lang, path, noindex = false, theme = 'hero', footer = true, snap = false, ogWidth = 1200, ogHeight = 630 } = Astro.props;
const d = t(lang);
const blocks: [string, string][] = [['top', lang === 'ru' ? 'Начало' : 'Start'], ['about', d.nav.about], ['services', d.nav.services], ['works', d.nav.works], ['process', d.nav.process], ['contacts', d.nav.contacts]];
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site ? Astro.site.origin : '';
const url = (l: Lang, p: string) => `${origin}${base}${langPrefix(l)}${p}`;
const canonical = url(lang, path);
const ogImage = `${origin}${base}${Astro.props.ogImage ?? (lang === 'en' ? '/og-en.png' : '/og.png')}`;
const other = lang === 'ru' ? 'en' : 'ru';
---
<!doctype html>
<html lang={d.htmlLang} data-theme={theme} class:list={[{ stage: snap }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- цвета сайта заданы вручную: запрещаем браузеру и расширениям перекрашивать светлые блоки в тёмные -->
    <meta name="color-scheme" content="only light" />
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l === 'ru' ? 'ru' : 'en'} href={url(l, path)} />)}
    <link rel="alternate" hreflang="x-default" href={url('ru', path)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="d1fast" />
    <meta property="og:title" content={Astro.props.title ?? d.meta.ogTitle} />
    <meta property="og:description" content={Astro.props.description ?? d.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={other === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1D34C9" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="preload" href={`${base}/fonts/geologica-cyr.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/golos-cyr.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: lang === 'ru' ? 'Савелий Лопатин' : 'Saveliy Lopatin',
      alternateName: 'd1fast',
      url: url(lang, '/'),
      jobTitle: lang === 'ru' ? 'Веб-разработчик' : 'Web developer',
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skipToContent}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer lang={lang} />}
    {snap && (
      <nav class="dots" aria-label={lang === 'ru' ? 'Блоки страницы' : 'Page blocks'} data-dots>
        {blocks.map(([id, label]) => <a href={`#${id}`} data-dot={id}><span class="dots__label">{label}</span></a>)}
      </nav>
    )}
    <script src="../scripts/main.ts"></script>
  </body>
</html>
