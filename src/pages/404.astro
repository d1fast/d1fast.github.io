---
import Base from '../layouts/Base.astro';
import { t, langPrefix } from '../i18n';
const ru = t('ru'); const en = t('en');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enChrome = {
  title: `404: ${en.notFound.title}`,
  skip: en.nav.skipToContent,
  policy: { text: en.contacts.policy, href: `${base}${langPrefix('en')}/policy/` },
};
---
<Base lang="ru" path="/404/" title={`404: ${ru.notFound.title}`} noindex>
  <section class="not-found container" data-lang-switch>
    <p class="not-found__code" aria-hidden="true">404</p>
    <div class="not-found__ru">
      <h1 class="not-found__title">{ru.notFound.title}</h1>
      <p class="not-found__text">{ru.notFound.text}</p>
      <p class="not-found__links"><a class="btn btn--primary" href={`${base}/`}>{ru.notFound.home}</a><a class="btn btn--ghost" href={`${base}/#works`}>{ru.notFound.works}</a></p>
    </div>
    <div class="not-found__en" lang="en" hidden>
      <h1 class="not-found__title">{en.notFound.title}</h1>
      <p class="not-found__text">{en.notFound.text}</p>
      <p class="not-found__links"><a class="btn btn--primary" href={`${base}${langPrefix('en')}/`}>{en.notFound.home}</a><a class="btn btn--ghost" href={`${base}${langPrefix('en')}/#works`}>{en.notFound.works}</a></p>
    </div>
  </section>
  <script type="application/json" data-en-chrome set:html={JSON.stringify(enChrome)} />
  <script>
    // Язык ошибки тоже зависит от предпочтений браузера, без перехода на несуществующий адрес.
    const preferred = (navigator.languages?.length ? navigator.languages : [navigator.language])
      .map(value => value.toLowerCase().split('-')[0]).find(value => value === 'ru' || value === 'en') || 'en';
    const en = preferred === 'en';
    if (en) {
      const c = JSON.parse(document.querySelector('[data-en-chrome]')?.textContent || '{}');
      document.documentElement.lang = 'en';
      document.title = c.title;
      document.querySelector('.not-found__ru')?.setAttribute('hidden', '');
      document.querySelector('.not-found__en')?.removeAttribute('hidden');
      const skip = document.querySelector('.skip-link'); if (skip) skip.textContent = c.skip;
      const pol = document.querySelector<HTMLAnchorElement>('.site-footer__policy'); if (pol) { pol.textContent = c.policy.text; pol.href = c.policy.href; }
    }
  </script>
</Base>
