---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Case from '../../../components/Case.astro';
export async function getStaticPaths() {
  const entries = await getCollection('work', (e) => e.id.endsWith('/en') && !e.data.draft && e.data.page);
  return entries.map((entry) => ({ params: { slug: entry.id.split('/')[0] }, props: { entry } }));
}
const { entry } = Astro.props;
const { slug } = Astro.params;
---
<Base lang="en" path={`/work/${slug}/`} title={`${entry.data.title}: case study. Saveliy Lopatin`} description={entry.data.subtitle} ogImage={entry.data.cover} ogWidth={1280} ogHeight={720} theme="works">
  <Case lang="en" entry={entry} slug={slug} />
</Base>
